# Node Express Backend .gitignore

# Dependencies
node_modules/

# TypeScript build output
dist/
*.tsbuildinfo

# Environment variables
.env
.env.*
!.env.example

# Multer uploads directory (ignore uploaded user images)
public/uploads/*
!public/uploads/.gitkeep

# Logs
logs/
*.log

# OS / Editor files
.DS_Store
.vscode/
.idea/
